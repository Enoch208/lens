{
  "appUrl": "http://localhost:3000",
  "variablesFile": ".testmuai/variables/local.json",
  "perTestTimeoutS": 420,
  "hookBudgetS": 1200,
  "maxAttempts": 3,
  "fallbackFlow": "member-removal",
  "ignore": [
    "packages/lens/**",
    ".lens/**",
    ".testmuai/**",
    ".claude/**",
    "docs/**",
    "scripts/**",
    "video/**",
    "README.md",
    "CLAUDE.md",
    "AGENTS.md",
    ".gitignore",
    "package-lock.json"
  ],
  "flows": {
    "member-removal": {
      "test": ".testmuai/tests/remove-member_test.md",
      "label": "Member removal",
      "risk": "HIGH",
      "protect": [
        "active_members",
        "billable_seats",
        "monthly_total",
        "billing_cadence"
      ],
      "observe": []
    },
    "member-invite": {
      "test": ".testmuai/tests/invite-member_test.md",
      "label": "Member invite",
      "risk": "MED",
      "protect": [
        "active_members",
        "billable_seats",
        "monthly_subtotal"
      ],
      "observe": []
    },
    "role-change": {
      "test": ".testmuai/tests/role-change_test.md",
      "label": "Role changes",
      "risk": "MED",
      "protect": [
        "sarah_role",
        "billable_seats",
        "monthly_subtotal"
      ],
      "observe": []
    },
    "billing": {
      "test": ".testmuai/tests/annual-billing_test.md",
      "label": "Billing",
      "risk": "HIGH",
      "protect": [
        "billable_seats",
        "price_per_seat",
        "monthly_subtotal"
      ],
      "observe": [
        "annual_discount",
        "billing_total"
      ]
    }
  }
}
